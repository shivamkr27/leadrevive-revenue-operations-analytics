KPI Lead count = COUNTROWS(LeadFacts)

KPI Contacted = SUM(LeadFacts[contacted])

KPI Uncontacted = [KPI Lead count]-[KPI Contacted]

KPI Qualified = SUM(LeadFacts[qualified])

KPI Won = SUM(LeadFacts[won])

KPI Open leads = SUM(LeadFacts[open])

KPI Scheduled = SUM(LeadFacts[scheduled])

KPI Overdue = SUM(LeadFacts[overdue])

KPI Response coverage = DIVIDE([KPI Contacted],[KPI Lead count])

KPI Qualified rate = DIVIDE([KPI Qualified],[KPI Lead count])

KPI Win rate = DIVIDE([KPI Won],[KPI Lead count])

KPI Overdue rate = DIVIDE([KPI Overdue],[KPI Scheduled])

KPI Median response hours = MEDIAN(LeadFacts[first_response_hours])

KPI Pipeline exposure INR = SUM(LeadFacts[pipeline_exposure_inr])

KPI SLA met = SUM(LeadFacts[sla_met])

KPI SLA breached = SUM(LeadFacts[sla_breached])

KPI Awaiting within SLA = SUM(LeadFacts[awaiting_within_sla])

KPI Rule eligible = SUM(LeadFacts[recovery_rule_eligible])