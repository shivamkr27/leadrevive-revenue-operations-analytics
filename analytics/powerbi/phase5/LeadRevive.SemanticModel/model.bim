            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Experiment",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:/project 1 -nontech/analytics/exports/generations/ec6fac1f9740442f906f00c0918cea4a/Experiment_SYNTHETIC.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Clean = Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Clean, {{\"arm\", type text}, {\"cohort\", Int64.Type}, {\"surfaced\", Int64.Type}, {\"followups_completed\", Int64.Type}, {\"overdue_remaining\", Int64.Type}, {\"action_rate\", type number}, {\"timing_basis\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "KPI Modeled contacts",
            "expression": "SUM(Experiment[followups_completed])",
            "formatString": "0"
          },
          {
            "name": "KPI Manual contacts",
            "expression": "CALCULATE(SUM(Experiment[followups_completed]),Experiment[arm]=\"manual\")",
            "formatString": "0"
          },
          {
            "name": "KPI Scan contacts",
            "expression": "CALCULATE(SUM(Experiment[followups_completed]),Experiment[arm]=\"automation\")",
            "formatString": "0"
          }
        ]
      },
      {
        "name": "Reconciliation",
        "columns": [
          {
            "name": "metric",
            "dataType": "string",
            "sourceColumn": "metric",
            "summarizeBy": "none"
          },
          {
            "name": "application",
