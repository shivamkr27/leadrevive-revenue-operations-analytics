            "summarizeBy": "none",
            "formatString": "0.0000"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Reconciliation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:/project 1 -nontech/analytics/exports/generations/ec6fac1f9740442f906f00c0918cea4a/Reconciliation_SYNTHETIC.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Clean = Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Clean, {{\"metric\", type text}, {\"application\", type number}, {\"sql\", type number}, {\"csv\", type number}, {\"excel\", type number}, {\"difference\", type number}, {\"status\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "KPI Actual DAX",
            "expression": "SWITCH(SELECTEDVALUE(Reconciliation[metric]),\"new_leads\",[KPI Lead count],\"contacted\",[KPI Contacted],\"uncontacted\",[KPI Uncontacted],\"won\",[KPI Won],\"qualified\",[KPI Qualified],\"active_scheduled\",[KPI Scheduled],\"overdue\",[KPI Overdue],\"first_response_coverage\",[KPI Response coverage],\"qualified_rate\",[KPI Qualified rate],\"win_rate\",[KPI Win rate],\"overdue_rate\",[KPI Overdue rate],\"median_first_response_hours\",[KPI Median response hours],\"pipeline_exposure_inr\",[KPI Pipeline exposure INR])",
            "formatString": "0.0000"
          },
          {
            "name": "KPI SQL check",
            "expression": "VAR a=[KPI Actual DAX] VAR b=SELECTEDVALUE(Reconciliation[sql]) RETURN IF(NOT(HASONEVALUE(Reconciliation[metric])),BLANK(),IF(IF(ISBLANK(a),ISBLANK(b),NOT(ISBLANK(b)) && ABS(a-b)<0.00000001),\"PASS\",\"FAIL\"))"
          }
        ]
      },
