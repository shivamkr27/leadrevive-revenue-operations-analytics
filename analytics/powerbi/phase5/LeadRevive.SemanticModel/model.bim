        ],
        "partitions": [
          {
            "name": "Operations",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:/project 1 -nontech/analytics/exports/generations/ec6fac1f9740442f906f00c0918cea4a/Operations_SYNTHETIC.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Clean = Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Clean, {{\"metric\", type text}, {\"value\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "KPI Reminded leads",
            "expression": "VALUE(CALCULATE(SELECTEDVALUE(Operations[value]),Operations[metric]=\"distinct_reminded_leads\"))",
            "formatString": "0"
          },
          {
            "name": "KPI Approvals",
            "expression": "VALUE(CALCULATE(SELECTEDVALUE(Operations[value]),Operations[metric]=\"sink_only_approvals\"))",
            "formatString": "0"
          },
          {
            "name": "KPI Sink accepted",
            "expression": "VALUE(CALCULATE(SELECTEDVALUE(Operations[value]),Operations[metric]=\"smtp_accepted_by_local_sink\"))",
            "formatString": "0"
          },
          {
            "name": "KPI Retried acceptance",
            "expression": "VALUE(CALCULATE(SELECTEDVALUE(Operations[value]),Operations[metric]=\"accepted_after_retry\"))",
            "formatString": "0"
          }
        ]
      },
