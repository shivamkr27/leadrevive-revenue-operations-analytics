                "    Clean = Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Clean, {{\"lead_id\", type text}, {\"origin\", type text}, {\"created_at\", type text}, {\"lead_source\", type text}, {\"campaign\", type text}, {\"stage\", type text}, {\"owner\", type text}, {\"owner_id\", type text}, {\"estimated_value_inr\", type number}, {\"open\", Int64.Type}, {\"contacted\", Int64.Type}, {\"qualified\", Int64.Type}, {\"won\", Int64.Type}, {\"scheduled\", Int64.Type}, {\"overdue\", Int64.Type}, {\"next_action_at\", type text}, {\"first_response_hours\", type number}, {\"response_sla_hours\", Int64.Type}, {\"sla_met\", Int64.Type}, {\"sla_breached\", Int64.Type}, {\"awaiting_within_sla\", Int64.Type}, {\"pipeline_exposure_inr\", type number}, {\"priority_score\", type number}, {\"recovery_rule_eligible\", Int64.Type}, {\"cohort_kind\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "KPI Lead count",
            "expression": "COUNTROWS(LeadFacts)",
            "formatString": "0"
          },
          {
            "name": "KPI Contacted",
            "expression": "SUM(LeadFacts[contacted])",
            "formatString": "0"
          },
          {
            "name": "KPI Uncontacted",
            "expression": "[KPI Lead count]-[KPI Contacted]",
            "formatString": "0"
          },
          {
            "name": "KPI Qualified",
            "expression": "SUM(LeadFacts[qualified])",
            "formatString": "0"
          },
          {
            "name": "KPI Won",
            "expression": "SUM(LeadFacts[won])",
            "formatString": "0"
          },
          {
            "name": "KPI Open leads",
            "expression": "SUM(LeadFacts[open])",
            "formatString": "0"
          },
          {
            "name": "KPI Scheduled",
            "expression": "SUM(LeadFacts[scheduled])",
            "formatString": "0"
          },
          {
            "name": "KPI Overdue",
            "expression": "SUM(LeadFacts[overdue])",
            "formatString": "0"
          },
          {
            "name": "KPI Response coverage",
            "expression": "DIVIDE([KPI Contacted],[KPI Lead count])",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Qualified rate",
            "expression": "DIVIDE([KPI Qualified],[KPI Lead count])",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Win rate",
            "expression": "DIVIDE([KPI Won],[KPI Lead count])",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Overdue rate",
            "expression": "DIVIDE([KPI Overdue],[KPI Scheduled])",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Median response hours",
            "expression": "MEDIAN(LeadFacts[first_response_hours])",
            "formatString": "0.0"
          },
          {
            "name": "KPI Pipeline exposure INR",
            "expression": "SUM(LeadFacts[pipeline_exposure_inr])",
            "formatString": "\u20b9 #,##0"
          },
          {
            "name": "KPI SLA met",
            "expression": "SUM(LeadFacts[sla_met])",
            "formatString": "0"
          },
          {
            "name": "KPI SLA breached",
            "expression": "SUM(LeadFacts[sla_breached])",
            "formatString": "0"
          },
          {
            "name": "KPI Awaiting within SLA",
            "expression": "SUM(LeadFacts[awaiting_within_sla])",
            "formatString": "0"
          },
          {
            "name": "KPI Rule eligible",
            "expression": "SUM(LeadFacts[recovery_rule_eligible])",
            "formatString": "0"
          }
        ]
