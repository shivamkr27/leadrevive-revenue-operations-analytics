# Safe placeholders only. Run scripts/configure_phase3.py to generate local credentials.
# Never paste real passwords in chat or commit .env.
DRY_RUN=true
LIVE_EMAIL_ENABLED=false
BUSINESS_TIMEZONE=Asia/Kolkata
# SQLite is the historical bootstrap; Compose supplies canonical PostgreSQL DATABASE_URL.
# DATABASE_URL=sqlite:///data/processed/leadrevive.sqlite
# Local values below are generated in ignored .env, not copied from this example:
# POSTGRES_PASSWORD=<generated>
# N8N_ENCRYPTION_KEY=<generated>
# LEADREVIVE_WEBHOOK_SECRET=<generated>
# N8N_OWNER_EMAIL=owner@leadrevive.example
# N8N_OWNER_PASSWORD=<generated>
# Optional fixed synthetic demo clock. Omit for live evaluation.
# LEADREVIVE_AS_OF=2026-10-24T12:00:00Z
# Compose deliberately reads .env; direct Phase 1/2 host scripts do not auto-load it.
# SMTP is restricted to Mailpit; there are no live-provider configuration values.
